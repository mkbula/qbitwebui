{
  "name": "qbitwebui",
  "private": true,
  "version": "2.45.0",
  "type": "module",
  "packageManager": "bun@1.3.2",
  "engines": {
    "bun": ">=1.3.2"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "dev": "concurrently \"bun run dev:server\" \"vite\"",
    "dev:server": "bun run --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "start": "bun run src/server/index.ts",
    "check": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src/",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "colord": "^2.10.0",
    "hono": "^4.13.13",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "tar-stream": "^3.2.2",
    "vaul": "^1.1.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "^3.1.5",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3"
  }
}
